    {
      "formId": "ordin-17542133",
      "sha256": "37a46f0fdb1d1d05debb88c833982acc113786df146fc26c6af5774a6b66da10",
      "lawId": "1930577",
      "lawTitle": "영천시 출산ㆍ양육 장려금 등에 관한 조례",
      "title": "[별지 제2호서식] 산모·신생아 건강관리 서비스 본인부담금 지원 신청서",
      "regionCode": "47230",
      "baselineState": "requires_external_confirmation",
      "currentState": "requires_external_confirmation",
      "dispositionChanged": false,
      "reason": "원본은 본인부담금 납부확인서/영수증과 산모 또는 배우자 계좌를 받아 서비스 종료 후 환급을 청구한다. 현행 조례 제5조제4항도 서비스 종료 후 2개월 이내 별지2를 지정하지만, 영천시 현재 서비스 안내와 경상북도 2026 정책은 서비스 전 산모 사전신청 후 산모 10%·보건소 90%로 분리 납부하고 제공기관이 사후 청구하는 절차를 명시한다. 조례 자체가 폐지됐다고 하지 않고 현행 운영과 옛 사후환급 서식 사이의 미해소 차이를 보존한다. 같은 페이지의 산후조리비 최대100만원 사후정산은 다른 사업이므로 기존 서식의 사용근거로 대체하지 않는다. 경상북도 공식 2026 달라지는 정책에서 2025년 산모100% 선납·90%환급→2026년 산모10%/보건소90% 분리 납부 변경을 직접 확인했다. 구 서식의 현재 환급단계 사용을 입증하지 못하며, 별도로 현행 임신준비 키트 신청서 1건을 확보했다. 남은 확인: 영천시가 현재 산모 본인 또는 배우자의 계좌로 본인부담금을 환급하는 예외를 인정하고 해당 별지2를 받는다는 공식 지침, 또는 현재 사전신청용 빈 신청서 원본.",
      "evidenceUrls": [
        "https://www.law.go.kr/LSW/flDownload.do?gubun=ELIS&flSeq=140505005&flNm=%5B%EB%B3%84%EC%A7%80+%EC%A0%9C2%ED%98%B8%EC%84%9C%EC%8B%9D%5D+%EC%82%B0%EB%AA%A8%C2%B7%EC%8B%A0%EC%83%9D%EC%95%84+%EA%B1%B4%EA%B0%95%EA%B4%80%EB%A6%AC+%EC%84%9C%EB%B9%84%EC%8A%A4+%EB%B3%B8%EC%9D%B8%EB%B6%80%EB%8B%B4%EA%B8%88+%EC%A7%80%EC%9B%90+%EC%8B%A0%EC%B2%AD%EC%84%9C",
