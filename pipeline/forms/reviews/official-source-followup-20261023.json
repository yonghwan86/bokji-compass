    {
      "formId": "ordin-17770713",
      "sha256": "97aed97286c1f8a7602ba8af1a0f27afb934480ccdce6e2e63f4a9669790d7e2",
      "lawId": "1633745",
      "lawTitle": "인제군 농어촌버스 미운행지역 희망택시 운행 및 이용주민 지원에 관한 조례 시행규칙",
      "title": "[별지 제1호서식] 희망택시 운행대상 마을 신청서",
      "regionCode": "51810",
      "baselineState": "requires_external_confirmation",
      "currentState": "reviewed_not_linked",
      "dispositionChanged": true,
      "reason": "2026-10-23 원본12288바이트/SHA와 전체239자, 현행 규칙1633745 제2조제2항·제3조 및 새 상위조례2178167 제3조·제5조·부칙을 대조하고 독립 재검토했다. 별지1은 읍·면장이 마을 위치·가구·거리·버스 현황을 작성해 군수에게 제출하는 행정 마을선정용이다. 사이트의 정확한 희망택시 사업은 이미 지정된 마을 주민의 탑승 이용으로, 규칙은 주민의 위성콜 요청을, 새 조례는 지정마을 주민 이용과 운송사업자 비용청구를 구분한다. 주민이 직접 내는 택시 이용신청서나 운송업자 청구서로 붙이지 않는다. 검색 실패가 아니라 작성 주체와 행정 단계의 적극적 불일치로 비신청인으로 분류하며 해당 교통복지나 주민 이용권이 없다는 뜻은 아니다.",
      "evidenceUrls": [
        "https://www.law.go.kr/ordinInfoP.do?ordinSeq=1633745",
        "https://www.law.go.kr/ordinInfoP.do?ordinSeq=2178167",
        "https://www.mohw.go.kr/board.es?mid=a60609000000&bid=0083&act=view&list_no=1489635&tag=&nPage=1"
      ],
