1e0f945e7395a83d0c08a8169a7cad"}},"file":{"hwp":"/forms/files/agency-41000-winter-heating-proxy-2026-03678-4dadc77cb36f.hwpx","format":"hwpx","bytes":123714,"sha256":"4dadc77cb36f1f5ffe37ea644a40c872e4c4ee189caa15d7a32f7cac587b0867"}}}}
