P.do?ordinSeq=1755517","kind":"official_page"},{"title":"성주군 인구정책 조례 시행규칙","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2103693","kind":"official_page"}]}},{"id":"g47840.bokjiro-WLF00005504","name":"성주군 중고등학교 신입생 교복구입비 지원","areaKey":"g47840","status":"available","links":[{"formId":"ordin-20810927","use":"main","evidenceUrl":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=1729269","evidenceNote":"조례 제6조는 학생 교복구입비를 별지 신청서로 학교 또는 읍면장에게 제출하도록 한다. 원본 앞뒤의 학생·부모보호자·중복수혜·계좌·동의와 사업이 인용한 동일 대상 및 신청절차가 일치한다. 기관 검토내역서가 아닌 부모 또는 보호자의 제1호 신청서를 확인했다.","checkedAt":"2026-10-18"}],"candidateFormIds":[],"applyType":"self","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"linked","candidateCount":0,"method":"full-index"},"investigation":{"state":"confirmed","checkedAt":"2026-10-23","applicationMentioned":false,"documentNames":["성주군 교복구입비 지원 조례.hwp"],"lawChecks":{"searched":1,"read":1,"failed":0},"pageChecks":{"attempted":1,"read":1,"failed":0,"unattempted":0},"sourceLinks":[{"title":"성주군 교복구입비 지원 조례.hwp","url":"https://www.bokjiro.go.kr/ssis-tbu/twata/CmmFileUtil/getDownload.do?atcflId=20240611UUWBM1042360088914270&atcflSn=1&wlfareInfoId=WLF00005504","kind":"attachment"},{"title":"성주군 중고등학교 신입생 교복구입비 지원","url":"https://www.bokjiro.go.kr/ssis-tbu/twataa/wlfareInfo/moveTWAT52011M.do?wlfareInfoId=WLF00005504&wlfareInfoReldBztpCd=02","kind":"official_page"},{"title":"성주군 교복구입비 지원 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=1729269","kind":"official_page"}]}},{"id":"g47840.gov24-521000000134","name":"성주군 출산육아용품대여실 운영","areaKey":"g47840","status":"available","links":[{"formId":"ordin-22662209","use":"conditional","condition":"조례 제6조의 출생일부터1년 이내 통합신청에 한정합니다. 성주군 출생가정이 출산서비스 통합신청에서 ‘출산육아용품 대여’를 신청하는 부분에 한정합니다. 실제 품목 선택·회원등록·물품 인수는 보건소 대여실의 절차를 따릅니다.","evidenceUrl":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2010659","evidenceNote":"성주군 조례 제6조제1항은 제5조 지원을 별지 제1호로 신청하고 제2항은 출생신고 때 행복출산 통합신청을 안내하도록 정한다. 실제3쪽 전체를 읽어 지방자치단체 서비스에 출생순위별 양육지원, 성주아기보험, 산후조리비, 영유아 영양제, 출산육아용품 대여가 각각 명시돼 있음을 확인했다. 앞의 세 사업은 사이트의 구체적 대상·급여·접수방법과 일치한다. 같은 관할에서 찾은 영양제·대여실 사업은 해당 지역 선택란과 목적이 같지만 통합신청 부분에만 한정하고 임산부 전체나 실제 물품 수령 양식으로 확대하지 않는다. 가족사진·태아초음파·풍진검사는 이 통합서식에 선택란이 없어 연결하지 않는다. 현재 삭제된 축하금 항목 및 전국 공통서비스는 제외했다. 공식 법규 ID·별표키·flSeq와 실제 원본의 SHA256·전체 본문 섹션을 재대조했다.","checkedAt":"2026-10-19"}],"candidateFormIds":["law-17998085","law-17998107","law-17998111","law-17998115","law-17998127"],"applyType":"self","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"linked","candidateCount":5,"method":"full-index"},"investigation":{"state":"confirmed","checkedAt":"2026-10-23","applicationMentioned":false,"documentNames":[],"lawChecks":{"searched":1,"read":1,"failed":0},"pageChecks":{"attempted":1,"read":1,"failed":0,"unattempted":0},"sourceLinks":[{"title":"성주군 출산육아용품대여실 운영","url":"https://www.gov.kr/portal/rcvfvrSvc/dtlEx/521000000134","kind":"official_page"},{"title":"모자보건법","url":"https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=286727","kind":"official_page"}]}},{"id":"g47840.gov24-521000000110","name":"세자녀 이상 가정 가족사진 지원","areaKey":"g47840","status":"review","links":[],"candidateFormIds":["ordin-22662209","law-17998085","law-17998107","law-17998111","law-17998115","law-17998127"],"applyType":"self","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"candidate","candidateCount":6,"method":"full-index"},"investigation":{"state":"candidate","checkedAt":"2026-10-23","applicationMentioned":true,"documentNames":[],"lawChecks":{"searched":2,"read":2,"failed":0},"pageChecks":{"attempted":1,"read":1,"failed":0,"unattempted":0},"sourceLinks":[{"title":"세자녀 이상 가정 가족사진 지원","url":"https://www.gov.kr/portal/rcvfvrSvc/dtlEx/521000000110","kind":"official_page"},{"title":"성주군 출산ᆞ양육 지원 등에 관한 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2010659","kind":"official_page"},{"title":"모자보건법","url":"https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=286727","kind":"official_page"}]}},{"id":"g47840.gov24-521000000101","name":"세자녀 이상 