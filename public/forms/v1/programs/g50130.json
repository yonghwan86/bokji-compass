56 및 flSeq를 대조했다.","checkedAt":"2026-10-18","scopeBasis":"provincial-law-reference"},{"formId":"ordin-20219407","use":"conditional","condition":"충혼묘지 안장자의 사망한 배우자를 합장하려는 경우","evidenceUrl":"https://www.law.go.kr/LSW/ordinInfoP.do?ordinSeq=1372961","evidenceNote":"유가족이 기존 안장자와 사망 배우자의 정보·관계를 작성하는 배우자 합장 별지3이다. 시행규칙 제2조제4항의 제주 충혼묘지 배우자 합장 절차와 일치한다. 실제 원본 전체 본문, 현행 법규의 지정 별지, 원본 SHA256 및 flSeq를 대조했다.","checkedAt":"2026-10-18","scopeBasis":"provincial-law-reference"}],"candidateFormIds":[],"applyType":"unknown","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"linked","candidateCount":0,"method":"full-index"},"investigation":{"state":"confirmed","checkedAt":"2026-10-23","applicationMentioned":false,"documentNames":[],"lawChecks":{"searched":2,"read":2,"failed":0},"pageChecks":{"attempted":0,"read":0,"failed":0,"unattempted":0},"sourceLinks":[{"title":"제주특별자치도 충혼묘지 및 충혼각 관리ᆞ운영 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=1808097","kind":"official_page"},{"title":"제주특별자치도 충혼묘지 및 충혼각 관리ᆞ운영 조례 시행규칙","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=1372961","kind":"official_page"}]}},{"id":"g50130.welfare100-vulnerable-fire-support","name":"취약계층 화재발생 긴급지원","areaKey":"g50130","status":"review","links":[],"candidateFormIds":["law-14073435"],"applyType":"unknown","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"candidate","candidateCount":1,"method":"full-index"},"investigation":{"state":"candidate","checkedAt":"2026-10-23","applicationMentioned":false,"documentNames":[],"lawChecks":{"searched":1,"read":1,"failed":0,"unresolvedCitations":1},"pageChecks":{"attempted":0,"read":0,"failed":0,"unattempted":0},"sourceLinks":[{"title":"긴급복지지원법","url":"https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=270789","kind":"official_page"}],"note":"사업 자료의 인용 1건은 법규명으로 특정하지 못했습니다. 사업계획·일반 지침명도 포함될 수 있습니다."}},{"id":"g50130.bokjiro-WLF00001647","name":"한부모가족복지시설 운영 지원(한부모가족복지시설 퇴소자 자립정착금)","areaKey":"g50130","status":"review","links":[],"ca