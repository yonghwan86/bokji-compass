26000000117","kind":"official_page"},{"title":"울릉군 교복 지원 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=1657259","kind":"official_page"}]}},{"id":"g47940.bokjiro-WLF00004777","name":"중증장애인 교통비 지원","areaKey":"g47940","status":"available","links":[{"formId":"ordin-22368931","use":"main","condition":"앞쪽은 신규·변경 신청용입니다. 뒤쪽 대리수령은 현행 제6조제3·4항의 본인계좌 사용 곤란 사유에 해당할 때만 작성합니다. 원본의 뒷면 조문번호는 구 표기로 현행 제6조와 대조하세요.","evidenceUrl":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2103707","evidenceNote":"전체 별지1 앞뒤의 신규/변경 신청·신청 위임·정보동의·대리수령 부분을 읽었다. 현행 제4조는 지급/변경에, 제6조제3·4항은 본인계좌 사용이 어려울 때 대리수령에 같은 별지1을 지정하고 사업 documents도 이 신청서를 명시한다. 원본 앞면 제6조·뒷면 제7조제3·4항 인용은 현행 신청 제4조/대리수령 제6조와 어긋나는 번호를 보존·기록한다. 대리수령 뒷면은 모든 신청인에게 필수 아님을 명시한다.","checkedAt":"2026-10-19"}],"candidateFormIds":[],"applyType":"self","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"linked","candidateCount":0,"method":"full-index"},"investigation":{"state":"confirmed","checkedAt":"2026-10-23","applicationMentioned":true,"documentNames":["울릉군저소득중증장애인교통비지원에관한조례.hwpx","별지 제1호서식 저소득 중증장애인 교통비 지급 신청서.hwp"],"lawChecks":{"searched":1,"read":1,"failed":0},"pageChecks":{"attempted":1,"read":1,"failed":0,"unattempted":0},"sourceLinks":[{"title":"울릉군저소득중증장애인교통비지원에관한조례.hwpx","url":"https://www.bokjiro.go.kr/ssis-tbu/twata/CmmFileUtil/getDownload.do?atcflId=20260728UUWBM1606460202739815&atcflSn=1&wlfareInfoId=WLF00004777","kind":"attachment"},{"title":"별지 제1호서식 저소득 중증장애인 교통비 지급 신청서.hwp","url":"https://www.bokjiro.go.kr/ssis-tbu/twata/CmmFileUtil/getDownload.do?atcflId=20230522UUWBM1029560035559446&atcflSn=1&wlfareInfoId=WLF00004777","kind":"attachment"},{"title":"중증장애인 교통비 지원","url":"https://www.bokjiro.go.kr/ssis-tbu/twataa/wlfareInfo/moveTWAT52011M.do?wlfareInfoId=WLF00004777&wlfareInfoReldBztpCd=02","kind":"official_page"},{"title":"울릉군 저소득 중증장애인 교통비 지원에 관한 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2103707","kind":"official_page"}]}},{"id":"g47940.gov24-526000000119","name":"지역화폐(울릉사랑상품권)","areaKey":"g47940","status":"available","links":[{"formId":"ordin-20864213","use":"main","condition":"종이형 울릉사랑상품권을 개인이 판매대행 금융기관에서 할인구매할 때 사용합니다. 원본의10퍼센트·월70만원과 사업 안내의12퍼센트 등은 시기별 조정될 수 있어 현재 판매 조건은 금융기관에서 확인합니다.","evidenceUrl":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2068453","evidenceNote":"원 출처 규칙2068453은 공식 API·MCP·국가법령정보센터 HTML 모두 조문과 부칙이 비어 있음을 확인했으며 읽었다고 간주하지 않는다. 다만 공식 제개정이유는 상위조례 제13조제3항의 구매한도 상향에 따라 바로 별지13 개인 할인구매 신청서를 수정한다고 명시한다. 현행 상위조례2070981 제13조제3항을 읽어10퍼센트·월70만원 및 별도조정 근거를 확인하고 정확한 첨부키20864213/flSeq와 전체 HWPX의 개인 구매·한도·서명·동의를 실제 종이상품권 금융기관 방문구매 사업에 대조했다.","checkedAt":"2026-10-19"}],"candidateFormIds":[],"applyType":"self","portalSearch":{"checkedAt":"2026-10-16T16:26:04.977154+00:00","outcome":"linked","candidateCount":0,"method":"full-index"},"investigation":{"state":"confirmed","checkedAt":"2026-10-23","applicationMentioned":false,"documentNames":[],"lawChecks":{"searched":3,"read":2,"failed":1},"pageChecks":{"attempted":1,"read":1,"failed":0,"unattempted":0},"sourceLinks":[{"title":"지역화폐(울릉사랑상품권)","url":"https://www.gov.kr/portal/rcvfvrSvc/dtlEx/526000000119","kind":"official_page"},{"title":"울릉군 울릉사랑상품권 이용 활성화에 관한 조례","url":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2070981","kind":"official_page"},{"title":"지역사랑상품권 이용 활성화에 관한 법률","url":"https://www.law.go.kr/LSW/lsInfoP.do?lsiSeq=273427","kind":"official_page"}],"note":"원문을 확인하지 못한 조회가 있습니다. 서식이 없다고 판단한 결과가 아닙니다."}},{"id":"g47940.bokjiro-WLF00004301","name":"참전유공자 사망위로금 지급","areaKey":"g47940","status":"available","links":[{"formId":"ordin-22368927","use":"main","condition":"묶음 중 내부 별지 제2호만 사용합니다. 제1호 월수당과 제3호 구 변경신고는 사망위로금 주신청서가 아닙니다.","evidenceUrl":"https://www.law.go.kr/ordinInfoP.do?ordinSeq=2103701","evidenceNote":"전체 원본 묶음 제1·2·3호를 읽고 현행 제5조·제8조가 신규/변경 모두 제1호, 사망은 제2호를 지정함을 확인했다. 내부3호는 구 변경신고 양식이 남아 있으나 현행 지정과 달라 사용범위에서 제외한다. 정부24 복합사업은 참전명예·배우자수당·사망을 모두 명시하고 복지로는 사망만 제공하므로 각각 실제 사용부분을 제한한다.","checkedAt":"2026-10-19","displayTitle":"울릉군 참전유공자 사망위로금 신청서(통합 서식)"}],"candidateFormIds":