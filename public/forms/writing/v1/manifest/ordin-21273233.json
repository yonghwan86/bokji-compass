{"kind":"text","text":"일"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":9,"col":0,"p":4},"segments":[]},{"kind":"paragraph","at":{"section":0,"table":0,"row":9,"col":0,"p":5},"segments":[{"kind":"text","text":"신청자              (인 또는 서명)"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":9,"col":0,"p":6},"segments":[{"kind":"text","text":"달성군농업기술센터 소장 귀하"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":9,"col":0,"p":7},"segments":[]}]}],[{"row":10,"col":0,"rowSpan":1,"colSpan":3,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":0},"segments":[]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":1},"segments":[{"kind":"text","text":"농기계 임대조건 및 준수사항"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":2},"segments":[{"kind":"text","text":"  1. 위 임대신청 농기계는 농업용으로만 사용하고 임대기간을 지켜야합니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":3},"segments":[{"kind":"text","text":"  2. 임대료의 납부기간은 임대허가일로부터 임대일 전까지입니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":4},"segments":[{"kind":"text","text":"  3. 농기계 작업종료 후 청소 및 세척 등을 통하여 반환하고 농기계를 반환할 때에는 "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":5},"segments":[{"kind":"text","text":"     고장유무에 대하여 소속직원의 확인을 받아야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":6},"segments":[{"kind":"text","text":"  4. 임대농기계를 농작업 이외의 목적으로 사용하거나, 타인에게 양도 또는 영업행위, "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":7},"segments":[{"kind":"text","text":"     사용신청사항이 허위 또는 부정한 방법으로 사용신청을 한 사실이 밝혀지면 사용"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":8},"segments":[{"kind":"text","text":"     허가를 취소하게 됩니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":9},"segments":[{"kind":"text","text":"  5. 사용허가조건을 이행하지 아니하는 경우에는 사용허가를 제한받습니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":10},"segments":[{"kind":"text","text":"  6. 사용자가 주의의무를 태만히 하여 농기계를 망실 또는 훼손하였을 경우 변상하여야 "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":11},"segments":[{"kind":"text","text":"     합니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":12},"segments":[{"kind":"text","text":"  7. 농기계를 출고한 후에 발생한 인적·물적 피해 사고 등에 대하여 민·형사상의 "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":13},"segments":[{"kind":"text","text":"     책임을 져야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":10,"col":0,"p":14},"segments":[{"kind":"text","text":"  8. 임대농기계의 구조 및 성능을 변경하여서는 안됩니다."}]}]}]]}],"slots":{"0/0/0/2/0":{"id":"0/0/0/2/0","kind":"text","at":{"section":0,"table":0,"row":0,"col":2,"p":0},"expect":"","budget":57,"width":{"available":33752,"styles":{"hangul":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":18},"label":"이 름"},"0/0/1/2/0":{"id":"0/0/1/2/0","kind":"text","at":{"section":0,"table":0,"row":1,"col":2,"p":0},"expect":"","budget":57,"width":{"available":33752,"styles":{"hangul":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"함초롬바탕","size":1200,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":18},"label":"주 소"},"0/0/2/2/0":{"id":"0/0/2/2/0","kind":"text","at":{"section":0,"table":0,"row":2,"col":2,"p":0},"expect":"