n":0,"table":0,"row":6,"col":0,"p":5},"segments":[{"kind":"slot","id":"0/0/6/0/5#i0"},{"kind":"text","text":"년"},{"kind":"slot","id":"0/0/6/0/5#i33"},{"kind":"text","text":"월"},{"kind":"slot","id":"0/0/6/0/5#i40"},{"kind":"text","text":"일"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":0,"p":6},"segments":[{"kind":"text","text":" "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":0,"p":7},"segments":[{"kind":"text","text":"                 신  청  인 :                    (서명 또는 날인)"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":0,"p":8},"segments":[]},{"kind":"table","index":1,"colCount":1,"rows":[[{"row":0,"col":0,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":0},"segments":[{"kind":"text","text":"  「개인정보 보호법」등 관련법령에 따라 나주사랑상품권의 가맹점 "}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":1},"segments":[{"kind":"text","text":"  지정 및 환전거래 시 필요한 개인정보에 대하여 수집 및 이용에 "}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":2},"segments":[{"kind":"text","text":"  동의함."}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":3},"segments":[{"kind":"text","text":"                   신 청 인 :                    (서명 또는 날인) "}]}]}]]},{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":0,"p":9},"segments":[{"kind":"text","text":"  나주시장 귀하"}]}]}],[{"row":7,"col":0,"rowSpan":1,"colSpan":2,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":7,"col":0,"p":0},"segments":[{"kind":"text","text":"구비서류"}]}]},{"row":7,"col":2,"rowSpan":1,"colSpan":4,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":7,"col":2,"p":0},"segments":[{"kind":"text","text":" 1. 사업자등록증 사본 1부."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":7,"col":2,"p":1},"segments":[{"kind":"text","text":" 2. 가맹점 준수사항 1부."}]}]}]]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":0},"segments":[{"kind":"text","text":"가맹점 준수사항"}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":1},"segments":[{"kind":"text","text":"  1. 가맹점은 물품 또는 용역을 제공할 때 나주사랑상품권(이하 “상품권”이라 한다)으로 거래한다는 이유로 상품권 결제를 거절하거나 사용자를 불리하게 대우하지 못한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":2},"segments":[{"kind":"text","text":"  2. 가맹점은 상품권을 다른 업소에 양도하거나, 현금대용 등 다른 용도로 사용하여서는 아니 된다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":3},"segments":[{"kind":"text","text":"  3. 가맹점은 상품권 사용자가 권면 금액 중 100분의 70이상의 물품 또는 용역을 제공받고 그 잔액의 환급을 요구할 때에는 즉시 이에 응하여야 한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":4},"segments":[{"kind":"text","text":"  4. 가맹점은 위법 또는 부정한 방법으로 발행된 상품권과 외관상 상품권으로서의 판별이 불가능한 정도로 훼손된 상품권, 그 밖에 나주시장의 인장 등의 날인이 없는 것과 같이 외관상 나주시장이 발행한 상품권이라 볼 수 없는 상품권을 취급하여서는 아니 된다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":5},"segments":[{"kind":"text","text":"  5. 가맹점의 책임 있는 사유로 제4호에 따른 상품권이 사용(회수)된 경우 그로 인한 손해는 원칙적으로 가맹점의 책임으로 한다. 다만, 가맹점이 주의의무를 다하였음에도 불구하고 식별할 수 없을 정도인 경우에는 나주시와 가맹점이 각각 해당 상품권 권면금액의 100분의 50을 책임진다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":6},"segments":[{"kind":"text","text":"  6. 가맹점은 사용(회수)된 상품권을 대금청구서와 함께 나주시가 판매대행점으로 협약한 관내 금융기관에 청구한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":7},"segments":[{"kind":"text","text":"  7. 가맹점이 회수한 상품권에 대하여 분실 등의 사유로 인한 손해는 가맹점의 책임으로 한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":8},"segments":[{"kind":"text","text":"  8. 가맹점은 상품권 소지자에게 「나주사랑상품권 관리 및 운영 조례」제11조제4항에서 정한 경우를 제외하고는 상품권에 표시된 금액을 현금으로 지급하여서는 아니 된다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":9},"segments":[{"kind":"text","text":"  9. 기존의 가맹점을 폐업하고 새로운 가맹점을 등록하고자 하는 경우에는 (가맹점 등록 철회신청서 제출 후) 다시 가맹점 등록을 하여야 한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":10},"segments":[{"kind":"text","text":"  10. 가맹점은 상품권 사용자가 알아보기 쉽게 『나주사랑상품권』취급 가맹점임을 표시하여야 한다."}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":11},"segments":[{"kind":"text","text":"년      월      일"}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":12},"segments":[{"kind":"text","text":"                                    신청인  주 소 : "}]},{"kind":"paragraph","at":{"section":1,"table":null,"row":0,"col":0,"p":13},"segments":[{"kind":"text","text":"                                            성 명 :            (서명 또는 날인)"}]}],"slots":{"0/0/1/3/0":{"id":"0/0/1/3/0","kind":"text","at":{"section":0,"table":0,"row":1,"col":3,"p":0},"expect":"","budget":19,"width":{"available":12614,"styles":{"hangul":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":6},"label":"상 호"},"0/0/1/5/0":{"id":"0/0/1/5/0","kind":"text","at":{"section":0,"table":0,"row":1,"col":5,"p":0},"expect":"","budget":20,"width":{"available":13468,"styles":{"hangul":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":6},"label":"업종 및 취급품목"},"0/0/2/3/0":{"id":"0/0/2/3/0","kind":"text","at":{"section":0,"table":0,"row":2,"col":3,"p":0},"expect":"","budget":19,"width":{"available":12614,"styles":{"hangul":{"family":"휴먼명조","size":1400,"ratio":97,"spacing":-3,"relS