},"unsupported":[{"reason":"선택지인지 확인할 수 없는 표시 기호는 원문 그대로 두었습니다.","count":11,"at":{"section":0,"table":0,"row":3,"col":2,"p":0}},{"reason":"원본 hangul 글꼴(바탕) 또는 글꼴 옵션을 지원하지 않아 인쇄한 뒤 직접 작성해 주세요.","count":2,"at":{"section":0,"table":0,"row":0,"col":0,"p":0}},{"reason":"그림·필드·탭·강제줄바꿈 등이 있는 문단은 한 줄 입력 범위를 보장할 수 없어 원문으로 두었습니다.","count":1,"at":{"section":0,"table":null,"row":0,"col":0,"p":0}}],"manual":["인쇄한 뒤 서명란에 직접 서명하거나 도장을 찍어 주세요. 이 화면은 서명을 만들지 않아요.","화면에서 열지 못한 칸은 인쇄한 뒤 직접 적어 주세요. 어떤 칸인지는 아래에 적어 두었어요.","내려받기는 접수 완료가 아니에요. 접수기관의 신청 안내와 구비서류를 함께 확인해 주세요."]}