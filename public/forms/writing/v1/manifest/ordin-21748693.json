aph","at":{"section":0,"table":0,"row":4,"col":0,"p":7},"segments":[{"kind":"text","text":"     - 성명, 생년월일, 성별, 주소, 연락처 및 취약계층 대상 여부(기초수급자, 장애인 등)"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":8},"segments":[{"kind":"text","text":"    나. 수집 및 이용 목적  "}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":9},"segments":[{"kind":"text","text":"     - 행복택시 이용자 현황 및 자격, 통계 관리"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":10},"segments":[{"kind":"text","text":"  ② 개인정보 보유 및 이용기간"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":11},"segments":[{"kind":"text","text":"     - 수집‧이용 동의일로부터 행복택시이용대상자 선정 기간 중"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":12},"segments":[{"kind":"text","text":"  ③ 동의거부 관리"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":13},"segments":[{"kind":"text","text":"     - 귀하께서는 본 안내에 따른 개인정보 수집, 이용에 대해서 동의를 거부하실 권리가 있습니다. 다만, 귀하가 개인정보의 수집/이용에 동의를 거부하시는 경우에 “행복택시” 이용에 불이익이 발생할 수 있음을 알려드립니다."}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":4,"col":0,"p":14},"segments":[]},{"kind":"table","index":1,"colCount":1,"rows":[[{"row":0,"col":0,"rowSpan":1,"colSpan":1,"role":"entry","nodes":[{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":0},"segments":[{"kind":"text","text":"본인은 위의 동의서 내용을 충분히 숙지하였으며, 개인정보 수집, 이용하는 것에 동의하시겠습니까?"}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":1},"segments":[]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":2},"segments":[{"kind":"text","text":"동의함 "},{"kind":"slot","id":"0/1/0/0/2#cs0"},{"kind":"text","text":"        동의안함 "},{"kind":"slot","id":"0/1/0/0/2#cs1"}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":3},"segments":[]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":4},"segments":[{"kind":"slot","id":"0/1/0/0/4#p0"},{"kind":"text","text":"년"},{"kind":"slot","id":"0/1/0/0