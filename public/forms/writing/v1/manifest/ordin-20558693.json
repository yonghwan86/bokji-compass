ph","at":{"section":0,"table":0,"row":6,"col":0,"p":0},"segments":[{"kind":"text","text":"희    망"}]},{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":0,"p":1},"segments":[{"kind":"text","text":"강습시간"}]}]},{"row":6,"col":1,"rowSpan":1,"colSpan":4,"role":"entry","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":6,"col":1,"p":0},"segments":[{"kind":"slot","id":"0/0/6/1/0"}]}]}],[{"row":7,"col":0,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":7,"col":0,"p":0},"segments":[{"kind":"text","text":"강 습 반"}]}]},{"row":7,"col":1,"rowSpan":1,"colSpan":4,"role":"entry","nodes":[{"kind":"paragraph","at":{"section":0,"table":0,"row":7,"col":1,"p":0},"segments":[{"kind":"slot","id":"0/0/7/1/0"}]}]}]]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":6},"segments":[{"kind":"text","text":"≪ 회 원 이 용 안 내 ≫"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":7},"segments":[{"kind":"text","text":"    1. 진안군 국민체육센터 개장시간은 평일은 06시부터 21시까지 토요일은 06 시부터 18시까지 일요일은 09시부터 18시까지 입니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":8},"segments":[{"kind":"text","text":"      ※ 동절기(11월 ∼ 2월)의 토요일, 일요일 폐장시간은 17시 입니다.  "}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":10},"segments":[{"kind":"text","text":"    2. 수영장 이용은 1회 2시간 사용 가능합니다.(2회 이상 가능)"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":12},"segments":[{"kind":"text","text":"    3. 유아는 취학 전 어린이를 말하며, 보호자 없이 입장할 수 없습니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":14},"segments":[{"kind":"text","text":"  「진안군 국민체육센터 관리 및 운영 조례」제6조의 규정에 따라 위와 같이 국민체육센터 이용료를 납부하고 회원 가입을 신청합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":16},"segments":[{"kind":"text","text":"     년     월     일"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":18},"segments":[{"kind":"text","text":"             신 청 인 :                (서명 또는 인)"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":20},"segments":[{"kind":"text","text":"   진 안 군 수 귀하"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":21},"segments":[{"kind":"text","text":"(뒷면)"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":23},"segments":[{"kind":"text","text":"이 용 수 칙"}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":25},"segments":[{"kind":"text","text":"1. 회원은 회원권을 항상 지녀야 하며 출입안내요원에게 제출 후 입장하여야 합니다. 회원권을 분실시 재발급 대금을 납부하셔야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":26},"segments":[{"kind":"text","text":"2. 회원권은 다른 사람에게 양도 및 대여할 수 없습니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":27},"segments":[{"kind":"text","text":"3. 귀중품 및 현금, 유가증권은 반드시 카운터에 보관하여 주시고 보관하지 않은 분실물은 체육센터에서 책임지지 않습니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":28},"segments":[{"kind":"text","text":"4. 열쇠분실 시 정해진 제작비를 변상하여야 하며, 열쇠분실로 인한 모든 사고는 체육센터에서 책임을 지지 않습니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":29},"segments":[{"kind":"text","text":"5. 수영장 입수 전 반드시 샤워 후 수영복, 수영모를 꼭 착용하셔야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":30},"segments":[{"kind":"text","text":"6. 미끄럼방지 및 환경보호를 위해 오일, 팩, 우유 마사지 등을 모두 금지합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":31},"segments":[{"kind":"text","text":"7. 피부병, 전염병, 고혈압 등 질환자는 수영을 금지하며, 충분한 준비운동 후 들어가셔야만 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":32},"segments":[{"kind":"text","text":"8. 수영장내에서는 절대금연 및 음식물을 반입하지 않으며, 풍기문란행위나 음주가무행위를 모두 금지합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":33},"segments":[{"kind":"text","text":"9. 수영장 실내에서는 뛰거나, 다이빙을 금지합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":34},"segments":[{"kind":"text","text":"10. 수영장내에서는 수상안전요원의 지시를 꼭 따라야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":35},"segments":[{"kind":"text","text":"11. 수영장 이용 시에는 반드시 유의사항을 숙지하고 입장하셔야 합니다."}]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":36},"segments":[{"kind":"text","text":"진안군 국민체육센터"}]}],"slots":{"0/0/0/4/0":{"id":"0/0/0/4/0","kind":"text","at":{"section":0,"table":0,"row":0,"col":4,"p":0},"expect":"","budget":22,"width":{"available":13918,"styles":{"hangul":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":22},"label":"회원번호"},"0/0/1/1/0":{"id":"0/0/1/1/0","kind":"text","at":{"section":0,"table":0,"row":1,"col":1,"p":0},"expect":"","budget":30,"width":{"available":19336,"styles":{"hangul":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false}},"charPrIDRef":22},"label":"성 명"},"0/0/1/4/0":{"id":"0/0/1/4/0","kind":"text","at":{"section":0,"table":0,"row":1,"col":4,"p":0},"expect":"","budget":22,"width":{"available":13918,"styles":{"hangul":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"latin":{"family":"바탕","size":1300,"ratio":100,"spacing":0,"relSz":100,"bold":false,"italic":false,"kerning":false,"embedded":false},"symbol":{"family":"바탕",