록번호), 전화번호, 구매금액이며, 구매시점부터 5년간 보관됩니다."}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":4},"segments":[{"kind":"text","text":"3. 개인정보를 제공받는 자: 홍성사랑상품권 발행·유통·판매대행(한국조폐공사, 금융기관 등)"}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":5},"segments":[{"kind":"text","text":"4. 동의를 거부할 권리 및 거부에 따른 불이익: 위 개인정보 수집․이용․제공 동의는 상품권 구매를 위하여 필수적이므로 위 사항에 동의하셔야만 상품권 구매가 가능합니다."}]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":6},"segments":[]},{"kind":"table","index":2,"colCount":2,"rows":[[{"row":0,"col":0,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":2,"row":0,"col":0,"p":0},"segments":[{"kind":"text","text":" 본인은 위와 같이 개인정보를 수집․이용하는 것에 동의합니다."}]}]},{"row":0,"col":1,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":2,"row":0,"col":1,"p":0},"segments":[{"kind":"text","text":"□ 동의함"}]},{"kind":"paragraph","at":{"section":0,"table":2,"row":0,"col":1,"p":1},"segments":[{"kind":"text","text":"□ 동의하지 않음"}]}]}],[{"row":1,"col":0,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":2,"row":1,"col":0,"p":0},"segments":[{"kind":"text","text":" 본인은 수집된 개인정보를 제3자에게 제공하는 것에 동의합니다."}]},{"kind":"paragraph","at":{"section":0,"table":2,"row":1,"col":0,"p":1},"segments":[{"kind":"text","text":" ※ 개인정보는 수집․이용․제공 목적외 다른 목적으로 활용되지 않습니다."}]}]},{"row":1,"col":1,"rowSpan":1,"colSpan":1,"role":"printed","nodes":[{"kind":"paragraph","at":{"section":0,"table":2,"row":1,"col":1,"p":0},"segments":[{"kind":"text","text":"□ 동의함"}]},{"kind":"paragraph","at":{"section":0,"table":2,"row":1,"col":1,"p":1},"segments":[{"kind":"text","text":"□ 동의하지 않음"}]}]}]]},{"kind":"paragraph","at":{"section":0,"table":1,"row":0,"col":0,"p":7},"segments":[{"kind":"text","text":" ※ 동의하지 않을 경우, 상품권 구매가 불가함을 알려드립니다. "}]}]}]]},{"kind":"paragraph","at":{"section":0,"table":null,"row":0,"col":0,"p":6},"segments":[{"kind":"text","text":" 